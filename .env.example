# Copy to .env.local and fill in.
#
# Local stack (npx supabase start) uses:
#   VITE_SUPABASE_URL="http://127.0.0.1:54321"
#   VITE_SUPABASE_PUBLISHABLE_KEY=<anon key printed by `npx supabase status`>
# Hosted project uses https://[project-ref].supabase.co and the project anon key.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Server-side only. Never expose with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=''

# Edge function secrets (also set in supabase/functions/.env for local serving).
RESEND_API_KEY=''
LOVABLE_API_KEY=''
